---
// Счётчики посещений. Включаются, когда в site.config.mjs заполнен
// yandexMetrikaId и/или posthogKey.
//
// Если analytics.requireConsent = true, счётчики загружаются только после
// того, как посетитель нажал «Принять» на плашке про cookie (CookieBanner).
//
// Свои события:
//  • в HTML: добавьте элементу атрибут data-track="имя_события" —
//    клик по нему будет отправлен автоматически;
//  • в JS:   window.track('имя_события', { любые: 'параметры' }).
import config from '../../site.config.mjs';
const { yandexMetrikaId, posthogKey, posthogHost, requireConsent } = config.analytics;
const settings = {
  ymId: yandexMetrikaId ? Number(yandexMetrikaId) : null,
  phKey: posthogKey || null,
  phHost: posthogHost,
  requireConsent: !!requireConsent,
  // код рубрики → название, чтобы в отчётах были понятные имена
  rubrics: Object.fromEntries([...config.rubrics, config.defaultRubric].map((r) => [r.slug, r.name])),
};
---

<script is:inline define:vars={{ settings }}>
  window.__analyticsSettings = settings;

  window.__loadAnalytics = function () {
    if (window.__analyticsLoaded) return;
    window.__analyticsLoaded = true;

    if (settings.ymId) {
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        k = e.createElement(t); a = e.getElementsByTagName(t)[0];
        k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
      window.ym(settings.ymId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
      window.__ymId = settings.ymId;
    }

    if (settings.phKey) {
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      window.posthog.init(settings.phKey, { api_host: settings.phHost, person_profiles: 'identified_only' });
    }
  };

  window.__getConsent = function () {
    try { return localStorage.getItem('cookie-consent'); } catch (e) { return null; }
  };

  if (!settings.requireConsent || window.__getConsent() === 'accepted') window.__loadAnalytics();

  window.track = function (name, props) {
    props = props || {};
    try { if (window.ym && window.__ymId) window.ym(window.__ymId, 'reachGoal', name, props); } catch (e) {}
    try { if (window.posthog && window.posthog.capture) window.posthog.capture(name, props); } catch (e) {}
  };
  // Параметры визита: в Метрике — отчёт «Посетители → Параметры визитов»
  window.trackParams = function (params) {
    try { if (window.ym && window.__ymId) window.ym(window.__ymId, 'params', params); } catch (e) {}
  };

  // Откуда кликнули: главная, список постов, страница поста, рубрика
  window.__pageKind = function () {
    var p = location.pathname;
    if (p === '/' || p === '') return 'с главной';
    if (/^\/posts\/\d+\/?$/.test(p)) return 'со страницы поста';
    if (/^\/posts\/?$/.test(p)) return 'из списка постов';
    if (/^\/rubrics\//.test(p)) return 'со страницы рубрик';
    return 'с другой страницы';
  };

  document.addEventListener('click', function (e) {
    if (!e.target.closest) return;
    var el = e.target.closest('[data-track]');
    if (el) window.track(el.getAttribute('data-track'), { href: el.getAttribute('href') || '', page: location.pathname });

    // Клики по рубрикам — любые ссылки на /rubrics/<код>/ и чипс «Все»
    var a = e.target.closest('a[href]');
    if (!a) return;
    var m = a.getAttribute('href').match(/\/rubrics\/([^/]+)\/?$/);
    var name = m ? settings.rubrics[m[1]] : a.classList.contains('chip') && /\/posts\/?$/.test(a.getAttribute('href')) ? 'Все' : null;
    if (!name) return;
    var from = window.__pageKind();
    var inner = {}; inner[name] = from;
    window.trackParams({ 'Клик по рубрике': inner });
    window.track('rubric_click', { rubric: name, from: from });
  });
</script>
