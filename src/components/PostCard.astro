---
import { url, formatDate } from '../lib/posts.js';
const { post, featured = false } = Astro.props;
const cover = post.images[0] || post.videos[0]?.thumb;
---

<article class:list={['card', 'post-card', { featured }]}>
  <a class="cover-link" href={url(`/posts/${post.id}/`)} aria-label={post.title}></a>
  {cover && featured && <img class="cover" src={cover} alt="" loading="lazy" />}
  <div class="body">
    <div class="meta">
      <a class="chip" data-rubric={post.rubric.slug} href={url(`/rubrics/${post.rubric.slug}/`)}>{post.rubric.name}</a>
      <span class="mono small">{formatDate(post.date)} · {post.readMinutes} мин</span>
    </div>
    <h3>{post.title}</h3>
    {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
    {post.hasCode && featured && <span class="mono code-badge">&lt;/&gt; есть код</span>}
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .post-card:hover {
    border-color: #b9cdee;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(14, 23, 38, 0.06);
  }
  .cover-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .chip {
    position: relative;
    z-index: 2;
  }
  .body {
    padding: 20px 22px 22px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .small {
    font-size: 12px;
    color: var(--muted);
  }
  h3 {
    font-size: 19px;
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .excerpt {
    font-size: 15px;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .featured h3 {
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.01em;
  }
  .cover {
    width: 100%;
    max-height: 340px;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .code-badge {
    display: inline-block;
    margin-top: 14px;
    font-size: 12px;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--code-bg);
    color: var(--code-ink);
  }
  @media (min-width: 820px) {
    .featured:has(.cover) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
    .featured .cover {
      height: 100%;
      max-height: none;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .featured .body {
      padding: 30px 32px;
      align-self: center;
    }
  }
</style>
