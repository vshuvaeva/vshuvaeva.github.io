---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { posts, allRubrics, url } from '../../lib/posts.js';

export function getStaticPaths() {
  return allRubrics.map((rubric) => ({ params: { slug: rubric.slug }, props: { rubric } }));
}

const { rubric } = Astro.props;
const list = posts.filter((p) => p.rubric.slug === rubric.slug);
---

<Base title={rubric.name} active="rubrics">
  <section class="wrap page">
    <h1 class="section-title">{rubric.name} <span class="mono count">{list.length}</span></h1>
    <div class="chips filters">
      <a class="chip" href={url('/posts/')}>Все</a>
      {
        allRubrics.map((r) => (
          <a class:list={['chip', { 'is-active': r.slug === rubric.slug }]} href={url(`/rubrics/${r.slug}/`)}>
            {r.name}
          </a>
        ))
      }
    </div>
    <div class="grid">
      {list.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: 64px;
  }
  .count {
    font-size: 0.5em;
    color: var(--accent);
    vertical-align: middle;
  }
  .filters {
    margin: 20px 0 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }
</style>
