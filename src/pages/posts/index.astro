---
import Base from '../../layouts/Base.astro';
import { posts, allRubrics, formatDate, url } from '../../lib/posts.js';

const byYear = Object.entries(
  posts.reduce((acc, p) => {
    const y = p.date ? new Date(p.date).getFullYear() : '—';
    (acc[y] ||= []).push(p);
    return acc;
  }, {}),
).sort((a, b) => Number(b[0]) - Number(a[0]));
---

<Base title="Все посты" active="posts">
  <section class="wrap page">
    <h1 class="section-title">Все посты <span class="mono count">{posts.length}</span></h1>
    <div class="chips filters">
      <a class="chip is-active" href={url('/posts/')}>Все</a>
      {allRubrics.map((r) => <a class="chip" data-rubric={r.slug} href={url(`/rubrics/${r.slug}/`)}>{r.name} · {r.count}</a>)}
    </div>

    {
      byYear.map(([year, list]) => (
        <div class="year">
          <h2 class="mono">{year}</h2>
          <ul class="card list">
            {list.map((p) => (
              <li>
                <a href={url(`/posts/${p.id}/`)}>
                  <span class="title">{p.title}</span>
                  <span class="chip" data-rubric={p.rubric.slug}>{p.rubric.name}</span>
                  <span class="mono date">{formatDate(p.date).replace(/ \d{4}.*$/, '')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .page {
    padding-top: 64px;
  }
  .count {
    font-size: 0.5em;
    color: var(--accent);
    vertical-align: middle;
  }
  .filters {
    margin: 20px 0 40px;
  }
  .year {
    margin-top: 36px;
  }
  .year h2 {
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 10px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }
  .list li + li {
    border-top: 1px solid var(--line);
  }
  .list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 110px;
    align-items: center;
    gap: 16px;
    padding: 14px 22px;
    text-decoration: none;
  }
  .list a:hover .title {
    color: var(--accent);
  }
  .title {
    font-weight: 500;
  }
  .date {
    font-size: 13px;
    color: var(--muted);
    text-align: right;
  }
  @media (max-width: 640px) {
    .list a {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 12px 16px;
    }
    .list .chip {
      justify-self: start;
    }
    .date {
      text-align: left;
    }
  }
</style>
